# ==============================================================================
# Git Ignore - CareerIntel
# ==============================================================================

# --- Secrets & Environment Configuration (CRITICAL: DO NOT COMMIT) ---
.env
.env.*
*.env
backend/.env
frontend/.env*
!*.env.example
!.env.example
!**/.env.example

# --- Internal Prompt Documents ---
master prompt.md
*prompt.md

# --- Uploaded Candidate Documents & Dynamic Storage ---
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.pdf
*.docx

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- Node.js & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.pnp
.pnp.js
*.tsbuildinfo
next-env.d.ts

# --- Logs & Runtime Data ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
